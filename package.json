{
  "name": "klaar",
  "private": true,
  "version": "0.1.0",
  "description": "Configurable virtual microphone with realtime DSP for macOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JyrgenSuvalov/klaar.git"
  },
  "bugs": {
    "url": "https://github.com/JyrgenSuvalov/klaar/issues"
  },
  "homepage": "https://github.com/JyrgenSuvalov/klaar#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "cargo build --release --manifest-path driver/Cargo.toml && bash scripts/stage-driver.sh && pnpm tauri dev",
    "stage-driver": "bash scripts/stage-driver.sh",
    "verify-bundle": "bash scripts/verify-bundle.sh",
    "build:driver": "bash scripts/build-driver.sh",
    "build:release": "bash scripts/build-release.sh",
    "build:release:universal": "KLAAR_DRIVER_UNIVERSAL=1 bash scripts/build-release.sh",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^4.1.2",
    "axe-core": "^4.11.3",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.0.4",
    "vitest": "^4.1.2"
  }
}
