{
  "name": "klaar",
  "private": true,
  "version": "0.3.1",
  "description": "Configurable virtual microphone with realtime DSP for macOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JyrgenSuvalov/klaar.git"
  },
  "bugs": {
    "url": "https://github.com/JyrgenSuvalov/klaar/issues"
  },
  "homepage": "https://github.com/JyrgenSuvalov/klaar#readme",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "bash scripts/build-driver.sh && bash scripts/stage-driver.sh && pnpm tauri dev",
    "build-driver": "bash scripts/build-driver.sh",
    "stage-driver": "bash scripts/stage-driver.sh",
    "verify-bundle": "bash scripts/verify-bundle.sh",
    "build:driver": "bash scripts/build-driver.sh",
    "build:release": "bash scripts/build-release.sh",
    "build:release:universal": "KLAAR_DRIVER_UNIVERSAL=1 bash scripts/build-release.sh",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
